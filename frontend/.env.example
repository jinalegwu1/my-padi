# Go API address; never add private provider keys to this file.
# Browser preview uses this address. Native development uses Expo's LAN host
# when this is a loopback URL, keeping the backend port below.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8080
# Set to the EAS project ID before building a native app for remote push.
EXPO_PUBLIC_EAS_PROJECT_ID=
