# Backend configuration only: never copy API keys into the frontend.
# From backend/, load before running Go commands:
#   set -a
#   . ./.env
#   set +a

# Add your real account keys here. Empty values keep providers unconfigured.
GEMINI_API_KEY=''
GROQ_API_KEY=''
ZAI_API_KEY=''
OPENROUTER_API_KEY=''

# Enable only exact models whose zero price and account access are verified.
# No provider model is enabled by this template.
PADI_AI_MODELS=''
PADI_AI_APPROVED_FREE_MODELS=''
# Set only after checking each account's free-tier eligibility and billing controls.
# Verification sends generation requests only for confirmed free accounts/models.
PADI_AI_FREE_ACCOUNT_CONFIRMED=''
# After checking account dashboards: PADI_AI_FREE_ACCOUNT_CONFIRMED='gemini,groq,zai,openrouter'
PADI_AI_PRIMARY_MODEL='gemini-primary'
PADI_AI_FAST_MODEL='groq-fast'
PADI_AI_REASONING_MODEL='zai-reasoning'
PADI_AI_BACKUP_MODEL='openrouter-backup'

# Selected free-tier models; recheck availability and free-account access before enabling.
# GLM-4.7-Flash uses the API ID glm-4.7-flash on the standard Z.ai endpoint.
# PADI_AI_MODELS='[{"id":"gemini-primary","provider":"gemini","model":"gemini-3.1-flash-lite","api_key_env":"GEMINI_API_KEY"},{"id":"groq-fast","provider":"groq","model":"openai/gpt-oss-20b","api_key_env":"GROQ_API_KEY"},{"id":"zai-reasoning","provider":"zai","model":"glm-4.7-flash","api_key_env":"ZAI_API_KEY"},{"id":"openrouter-backup","provider":"openrouter","model":"nvidia/nemotron-3.5-lightning:free","api_key_env":"OPENROUTER_API_KEY"}]'
# PADI_AI_APPROVED_FREE_MODELS='gemini:gemini-3.1-flash-lite,groq:openai/gpt-oss-20b,zai:glm-4.7-flash,openrouter:nvidia/nemotron-3.5-lightning:free'

# Use your application database here. The verifier can use PADI_TEST_DATABASE_URL
# when DATABASE_URL is empty, keeping checks in a separate disposable database.
DATABASE_URL=''
PADI_TEST_DATABASE_URL=''
PADI_HTTP_ADDR='0.0.0.0:8080'
PADI_FRONTEND_PORT='8081'
PADI_CORS_ORIGINS='http://localhost:8081,http://127.0.0.1:8081'
# Optional Expo Push Security access token; never put this in the mobile app.
PADI_EXPO_ACCESS_TOKEN=''

# Temporary OTP bypass: requires PADI_ENV='development' and PostgreSQL.
# Keep false outside local development. No SMS credentials are needed when true.
PADI_ENV='production'
PADI_DEV_BYPASS_OTP='false'
# Development testing only: disables PADI request/token caps, retaining the
# PostgreSQL usage ledger. Vendor rate limits still apply. Requires development.
PADI_DEV_BYPASS_AI_USAGE_LIMITS='false'

# Voice recognition: Groq Whisper transcription; replies use Python speech.
# Requires GROQ_API_KEY and groq in PADI_AI_FREE_ACCOUNT_CONFIRMED.
# Independent of PADI_AI_APPROVED_FREE_MODELS (which is for text models).
PADI_STT_ENABLED='false'

# Independent Python Voice Engine: VAD, audio preparation, recognition, and
# expressive speech. Requires Python setup and confirmed Gemini/Groq accounts.
PADI_PYTHON_VOICE_ENABLED='false'
PADI_PYTHON_VOICE_URL='http://127.0.0.1:8090'
PADI_PYTHON_VOICE_PORT='8090'
PADI_VOICE_SERVICE_TOKEN=''
# Select only after confirming the account's free-tier model access.
# The newer model supports original voice profiles; the earlier model remains available.
PADI_VOICE_MODEL='gemini-3.1-flash-tts-preview'
# A supported alternative is tried when the primary is rate-limited or unavailable.
# Defaults to Gemini 2.5 Flash TTS as fallback; empty disables it.
# Each attempt is accounted for in Go. Original voice profiles use their mapped
# prebuilt persona on the earlier model and return when primary quota resets.
# PADI_VOICE_FALLBACK_MODEL='gemini-2.5-flash-preview-tts'
# Optional fast English/Pidgin speech at normal pace, using the existing Groq
# account. The org admin must accept Orpheus model terms in the Groq console.
# Other languages/paces and service failures retain the Gemini speech path.
PADI_LIVE_VOICE_PROVIDER='gemini'
# Optional project-scoped original voice ID created with Gemini Voice design.
# Supported with gemini-3.8-flash-tts and gemini-3.8-flash-lite-tts.
# Never use a real-person imitation.
PADI_VOICE_DEFAULT_ID=''
# Fixed public introductions and previews only; personal speech is not cached.
PADI_VOICE_SAMPLE_CACHE_DIR='.voice-samples'

# When OTP is enabled, phone authentication needs these operator-provided values.
TERMI_API_KEY=''
TERMI_SENDER_ID=''
TERMI_API_BASE_URL=''
PADI_AUTH_PEPPER=''
